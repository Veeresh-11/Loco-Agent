{
  "name": "loco-agent",
  "displayName": "LOCO Agent",
  "description": "Local-first coding assistant with workspace awareness, routing, and cloud fallback for VS Code.",
  "version": "0.1.0",
  "publisher": "veeresh",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "ai",
    "assistant",
    "coding",
    "chat",
    "llm",
    "ollama",
    "openai"
  ],
  "icon": "media/loco-agent-colored-128x128.png",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:loco.runAgent",
    "onCommand:loco.openAssistant",
    "onCommand:loco.openSettings",
    "onView:locoAgent.chatView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "loco-sidebar",
          "title": "LOCO Agent",
          "icon": "media/loco-agent-colored-128x128.png"
        }
      ]
    },
    "views": {
      "loco-sidebar": [
        {
          "id": "locoAgent.chatView",
          "name": "Assistant",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "loco.runAgent",
        "title": "LOCO: Run Agent"
      },
      {
        "command": "loco.openAssistant",
        "title": "LOCO: Open Assistant"
      },
      {
        "command": "loco.openSettings",
        "title": "LOCO: Open Settings"
      },
      {
        "command": "locoAgent.setEndpoint",
        "title": "LOCO: Set Endpoint"
      },
      {
        "command": "locoAgent.clearEndpoint",
        "title": "LOCO: Clear Endpoint"
      },
      {
        "command": "locoAgent.viewHistory",
        "title": "LOCO: View History"
      },
      {
        "command": "locoAgent.exportHistory",
        "title": "LOCO: Export History"
      },
      {
        "command": "locoAgent.clearHistory",
        "title": "LOCO: Clear History"
      }
    ],
    "configuration": {
      "title": "LOCO Agent",
      "properties": {
        "locoAgent.provider": {
          "type": "string",
          "default": "local",
          "enum": [
            "local",
            "openai",
            "azure",
            "ollama",
            "gpt4all"
          ],
          "description": "Preferred provider for prompt routing."
        },
        "locoAgent.endpoint": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "Cloud AI provider endpoint."
        },
        "locoAgent.localEndpoint": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Local LLM endpoint for Ollama or other OpenAI-compatible servers."
        },
        "locoAgent.storeHistory": {
          "type": "boolean",
          "default": true,
          "description": "Store chat history in the extension state."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "jest",
    "lint": "eslint src --ext ts",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^8.40.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "uuid": "^9.0.0"
  }
}
